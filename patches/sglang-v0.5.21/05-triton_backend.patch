+# --- decode-at-long-context measurement mode (SGLANG_FAKE_VERIFY_CTX_FILE=1) -------------------
+# When /tmp/fake_verify_ctx holds N > 0, single-request target-verify steps make the full-attention
+# layers attend over N consecutive slots of the real KV pool instead of the request's own prefix: the
+# same KV bytes and kernel work as an N-token context, without an N-token prefill. Outputs are
+# meaningless while it is on; it exists only to time decode at long context.
+_FAKE_CTX = {"n": 0, "calls": 0, "filled": 0}
+
+
+def _fake_verify_ctx() -> int:
+    if os.environ.get("SGLANG_FAKE_VERIFY_CTX_FILE", "0") != "1":
+        return 0
+    c = _FAKE_CTX
+    c["calls"] += 1
+    if c["calls"] % 32 == 1:
+        try:
+            with open("/tmp/fake_verify_ctx") as f:
+                c["n"] = int(f.read().strip() or 0)
+        except (OSError, ValueError):
+            c["n"] = 0
+    return c["n"]
+
