+    def _fi_prepare(self, forward_batch: ForwardBatch, bs: int):
+        """Paged-KV view (whole sequences: prefix + this chunk) of the batch for FlashInfer.
+
+        Token ids come from the same read stream the Triton kernels use; with page_size P the P tokens of a page
+        are contiguous and page-aligned, so every P-th id // P is the page id."""
+        ps = self.page_size
+        # host copies of the lengths (one sync per prefill batch when the scheduler did not provide them)
+        seq_cpu = forward_batch.seq_lens_cpu
+        seq = [int(x) for x in (seq_cpu if seq_cpu is not None else forward_batch.seq_lens)[:bs].tolist()]
+        ext_cpu = forward_batch.extend_seq_lens_cpu
+        ext = [int(x) for x in (ext_cpu if ext_cpu is not None else forward_batch.extend_seq_lens[:bs].tolist())[:bs]]
+        tok_indptr = torch.zeros(bs + 1, dtype=torch.int32, device=self.device)
+        tok_indptr[1:] = torch.cumsum(forward_batch.seq_lens[:bs], dim=0)
+        tok = torch.empty(sum(seq), dtype=torch.int64, device=self.device)
+        self.kv_index_translator.fill_packed_read_stream(
+            req_pool_indices=forward_batch.req_pool_indices[:bs],
+            seq_lens=forward_batch.seq_lens[:bs],
+            indptr=tok_indptr,
+            total_tokens=tok.numel(),
+            out=tok,
+        )
+        pages, start = [], 0
+        for n in seq:
+            pages.append(tok[start : start + n : ps])
+            start += n
+        kv_page_indices = (torch.cat(pages) // ps).to(torch.int32)
+        npages = [(n + ps - 1) // ps for n in seq]
+        kv_page_indptr = torch.zeros(bs + 1, dtype=torch.int32)
+        kv_page_indptr[1:] = torch.cumsum(torch.tensor(npages, dtype=torch.int32), 0)
+        last_page_len = torch.tensor([n - (m - 1) * ps for n, m in zip(seq, npages)], dtype=torch.int32)
+        qo_indptr = torch.zeros(bs + 1, dtype=torch.int32)
+        qo_indptr[1:] = torch.cumsum(torch.tensor(ext, dtype=torch.int32), 0)
+        self._fi_args = (qo_indptr, kv_page_indptr, kv_page_indices, last_page_len)
+
+    def _fi_full_attention(self, q: torch.Tensor, o: torch.Tensor, layer: RadixAttention) -> bool:
+        ps = self.page_size
+        k_buf = self.token_to_kv_pool.get_key_buffer(layer.layer_id)
+        v_buf = self.token_to_kv_pool.get_value_buffer(layer.layer_id)
+        if (
+            k_buf.dtype != q.dtype
+            or v_buf.dtype != q.dtype
+            or k_buf.shape[0] % ps
+            or v_buf.shape[0] % ps
+            or not k_buf.is_contiguous()
+            or not v_buf.is_contiguous()
+            or not o.is_contiguous()
+        ):
+            return False
+        key = (layer.tp_q_head_num, layer.tp_k_head_num, layer.qk_head_dim, layer.v_head_dim, float(layer.scaling))
+        if self._fi_planned != key:
+            if self._fi_wrapper is None:
+                import flashinfer
+
+                self._fi_workspace = torch.empty(256 << 20, dtype=torch.uint8, device=self.device)
+                self._fi_wrapper = flashinfer.BatchPrefillWithPagedKVCacheWrapper(
+                    self._fi_workspace, kv_layout="NHD", backend="fa2"
+                )
+            qo_indptr, kv_page_indptr, kv_page_indices, last_page_len = self._fi_args
+            self._fi_wrapper.plan(
+                qo_indptr, kv_page_indptr, kv_page_indices, last_page_len,
+                layer.tp_q_head_num, layer.tp_k_head_num, layer.qk_head_dim, ps,
+                causal=True, head_dim_vo=layer.v_head_dim, q_data_type=q.dtype, kv_data_type=k_buf.dtype,
+                sm_scale=layer.scaling,
+            )
+            self._fi_planned = key
+        self._fi_wrapper.run(
+            q.view(-1, layer.tp_q_head_num, layer.qk_head_dim),
+            (
+                k_buf.view(-1, ps, layer.tp_k_head_num, layer.qk_head_dim),
+                v_buf.view(-1, ps, layer.tp_k_head_num, layer.v_head_dim),
+            ),
+            out=o.view(-1, layer.tp_q_head_num, layer.v_head_dim),
+        )
+        return True
