+def _skinny_gemm_ext():
+    """Decode-sized bf16 GEMM (skinny_gemm.cu, opt-in via SGLANG_SKINNY_GEMM=1): streams W with
+    16-byte loads and keeps x in shared memory; ~10-28% faster than cuBLAS on GB10 for M <= 4."""
+    global _SKINNY_EXT
+    if _SKINNY_EXT is None:
