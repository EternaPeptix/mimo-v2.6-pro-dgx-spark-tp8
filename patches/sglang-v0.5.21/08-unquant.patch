+        if os.environ.get("SGLANG_SKINNY_GEMM", "0") == "1":
+            try:
+                import sys as _sys
+
+                d = os.environ.get("SKINNY_GEMM_DIR", "/skinny/build")
+                if d not in _sys.path:
+                    _sys.path.insert(0, d)
+                import skinny_gemm_ext
+
+                _SKINNY_EXT = skinny_gemm_ext
+            except Exception as e:  # fall back to the stock GEMM
+                logger.warning("skinny_gemm unavailable: %s", e)
+    return _SKINNY_EXT or None
