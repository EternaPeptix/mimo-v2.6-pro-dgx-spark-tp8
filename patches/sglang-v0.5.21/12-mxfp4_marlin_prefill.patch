+# Large-batch (prefill) MoE GEMMs for MXFP4 experts stored in Marlin's layout.
+#
+# Marlin (moe_wna16_marlin) is built for decode: for an 8K-token prefill chunk it re-reads and re-decodes each
+# expert's FP4 weights for every 64-token block and reaches ~25 TFLOPS on GB10. These Triton kernels read the
+# same repacked weights and E8M0 scales (no second copy), decode them in registers to exact BF16 values and run
+# BF16 tensor-core MMAs with FP32 accumulation. Activations stay BF16, so results match Marlin up to summation
+# order (both are within BF16 rounding of an FP32 reference).
+#
+# Marlin FP4 layout (gptq_marlin_repack, num_bits=4, no act-order): per expert a [K/16, 2N] int32 array of
+# 16x64 (k x n) tiles of 128 words, tile (kt, nt) at word (kt * N/64 + nt) * 128. Inside a tile, word t*4 + w
+# (t = 0..31, w = 0..3) holds 8 nibbles; nibble i = 4*i2 + 2*i1 + i0 is the weight at
+#   k = kt*16 + 8*i0 + 2*(t % 4) + i2,    n = nt*64 + 16*w + 8*i1 + t // 4.
+# Scales: E8M0 bytes [K/32, N] per expert; within every 64-column block, column r is stored at
+#   q(r) = 4*(p//4) + [0,2,1,3][p%4] with p = 8*(r%8) + r//8   (8x8 transpose, then a pair swap).
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fp4x8_to_bf16(q, m0, m1):
+    """One Marlin word -> its 8 weights as bf16 (outputs in nibble order 0..7).
+
+    (q & 0x80008000) | ((q & 0x70007000) >> 6) turns nibbles 3 and 7 into the two halves of a bf16x2 whose
+    value is fp4 * 2^-126 (0.5 becomes a bf16 subnormal); shifting q by 4/8/12 does the same for nibbles 2/6,
+    1/5, 0/4. Multiplying by 2^126 and then by the E8M0 scale 2^(s-127) is exact. m0 scales the nibbles of
+    column n (0, 1, 4, 5), m1 those of column n + 8 (2, 3, 6, 7); both are bf16x2 pairs.
+    """
+    return tl.inline_asm_elementwise(
+        asm="""
+        {
+        .reg .b32 x, s, t, b;
+        mov.b32 b, 0x7E807E80;
+        mov.b32 x, $8;
+        and.b32 s, x, 0x80008000;
+        and.b32 t, x, 0x70007000;
+        shr.b32 t, t, 6;
+        or.b32 t, t, s;
+        mul.rn.bf16x2 t, t, b;
+        mul.rn.bf16x2 t, t, $10;
+        mov.b32 {$3, $7}, t;
+        shl.b32 x, x, 4;
+        and.b32 s, x, 0x80008000;
+        and.b32 t, x, 0x70007000;
+        shr.b32 t, t, 6;
+        or.b32 t, t, s;
+        mul.rn.bf16x2 t, t, b;
+        mul.rn.bf16x2 t, t, $10;
+        mov.b32 {$2, $6}, t;
+        shl.b32 x, x, 4;
+        and.b32 s, x, 0x80008000;
+        and.b32 t, x, 0x70007000;
+        shr.b32 t, t, 6;
+        or.b32 t, t, s;
+        mul.rn.bf16x2 t, t, b;
+        mul.rn.bf16x2 t, t, $9;
+        mov.b32 {$1, $5}, t;
+        shl.b32 x, x, 4;
+        and.b32 s, x, 0x80008000;
+        and.b32 t, x, 0x70007000;
+        shr.b32 t, t, 6;
+        or.b32 t, t, s;
+        mul.rn.bf16x2 t, t, b;
+        mul.rn.bf16x2 t, t, $9;
+        mov.b32 {$0, $4}, t;
+        }
+        """,
+        constraints="=h,=h,=h,=h,=h,=h,=h,=h,r,r,r",
+        args=[q, m0, m1],
+        dtype=(tl.bfloat16,) * 8,
+        is_pure=True,
+        pack=1,
+    )
+
+
+@triton.jit
+def _scale_pair_ptrs(s_base, N, n0, I1: tl.constexpr, KT: tl.constexpr, NT: tl.constexpr):
+    """Pointers [KT, NT, 8, 1, 4] to the E8M0 scale of each Marlin word's column n + 8*I1 (k-group kt // 2)."""
+    kt = tl.reshape(tl.arange(0, KT), (KT, 1, 1, 1, 1))
+    nt = tl.reshape(tl.arange(0, NT), (1, NT, 1, 1, 1))
+    th = tl.reshape(tl.arange(0, 8), (1, 1, 8, 1, 1))
+    w = tl.reshape(tl.arange(0, 4), (1, 1, 1, 1, 4))
+    r = 16 * w + 8 * I1 + th
+    p = (r % 8) * 8 + r // 8
+    pm = p % 4
+    q = p - pm + tl.where(pm == 1, 2, tl.where(pm == 2, 1, pm))
+    return s_base + (kt // 2) * N + n0 + nt * 64 + q
+
+
+@triton.jit
+def _decode_fp4_tile(W, s0, s1, BK: tl.constexpr, BN: tl.constexpr):
+    """W: [BK//16, 2*BN] int32 Marlin words; s0/s1: [KT, NT, 8, 1, 4] uint8 scales -> [BK, BN] bf16."""
+    KT: tl.constexpr = BK // 16
+    NT: tl.constexpr = BN // 64
+    W = tl.reshape(W, (KT, NT, 8, 4, 4))
+    s0 = s0.to(tl.int32)
+    s1 = s1.to(tl.int32)
+    m0 = tl.broadcast_to((s0 << 7) | (s0 << 23), (KT, NT, 8, 4, 4))
+    m1 = tl.broadcast_to((s1 << 7) | (s1 << 23), (KT, NT, 8, 4, 4))
+    o0, o1, o2, o3, o4, o5, o6, o7 = _fp4x8_to_bf16(W, m0, m1)
+    v = tl.join(tl.join(tl.join(o0, o1), tl.join(o2, o3)), tl.join(tl.join(o4, o5), tl.join(o6, o7)))
+    # dims: (kt, nt, t_hi, t_lo, w, i0, i1, i2) -> (kt, i0, t_lo, i2 | nt, w, i1, t_hi) = (k | n)
+    v = tl.permute(v, (0, 5, 3, 7, 1, 4, 6, 2))
+    return tl.reshape(v, (BK, BN))
+
+
+@triton.jit
+def _mxfp4_marlin_moe_kernel(
+    A, B, S, C, topk_weights,
+    sorted_token_ids, expert_ids, num_tokens_post_padded,
+    N, K, num_valid_tokens, stride_am, stride_cm,
+    A_ROW_DIV: tl.constexpr,      # top_k when A has one row per token (w13), 1 when one per (token, k) (w2)
+    MUL_TOPK_W: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    num_pid_n = N // BN
+    pid_m = pid // num_pid_n       # n fastest: CTAs of one token block run together and share A in L2
+    pid_n = pid % num_pid_n
+    if pid_m * BM >= tl.load(num_tokens_post_padded):
+        return
+    expert = tl.load(expert_ids + pid_m).to(tl.int64)
+    if expert < 0:
+        return
+    tok = tl.load(sorted_token_ids + pid_m * BM + tl.arange(0, BM))
+    tmask = tok < num_valid_tokens
+    a_row = tl.where(tmask, tok // A_ROW_DIV, 0).to(tl.int64)
+    a_ptrs = A + a_row[:, None] * stride_am + tl.arange(0, BK)[None, :]
+    KT: tl.constexpr = BK // 16
+    NT: tl.constexpr = BN // 64
+    n0 = pid_n * BN
+    b_ptrs = (B + expert * (K // 16) * (2 * N)
+              + tl.arange(0, KT)[:, None] * (2 * N) + (2 * n0 + tl.arange(0, 2 * BN))[None, :])
+    s_base = S + expert * (K // 32) * N
+    s0_ptrs = _scale_pair_ptrs(s_base, N, n0, 0, KT, NT)
+    s1_ptrs = _scale_pair_ptrs(s_base, N, n0, 1, KT, NT)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for _ in range(0, K, BK):
+        a = tl.load(a_ptrs, mask=tmask[:, None], other=0.0)
+        b = _decode_fp4_tile(tl.load(b_ptrs), tl.load(s0_ptrs), tl.load(s1_ptrs), BK, BN)
+        acc = tl.dot(a, b, acc)
+        a_ptrs += BK
+        b_ptrs += KT * (2 * N)
+        s0_ptrs += (BK // 32) * N
+        s1_ptrs += (BK // 32) * N
+    if MUL_TOPK_W:
+        acc = acc * tl.load(topk_weights + tok, mask=tmask, other=0.0)[:, None]
+    c_ptrs = C + tok.to(tl.int64)[:, None] * stride_cm + (n0 + tl.arange(0, BN))[None, :]
+    tl.store(c_ptrs, acc.to(C.dtype.element_ty), mask=tmask[:, None])
+
+
+# (BN, BK, num_warps, num_stages) tuned on GB10 at MiMo-V2.6-Pro TP8 shapes: w13 K=6144 N=512, w2 K=256 N=6144.
+_LONG_K_CFG = (128, 64, 8, 3)
+_SHORT_K_CFG = (64, 32, 4, 4)
+BLOCK_M = 64
+
+
+def supports(b_q: torch.Tensor) -> bool:
+    K = b_q.shape[1] * 16
+    N = b_q.shape[2] // 2
+    return N % 128 == 0 and K % 64 == 0
+
+
+def mxfp4_marlin_moe_gemm(a, b_q, b_scales, c, topk_weights, sorted_token_ids, expert_ids,
+                          num_tokens_post_padded, top_k, mul_topk_weights):
+    """c[r, :N] = a[r // top_k or r] @ dequant(b_q[expert(r)]).T (* topk_weights[r]) for every sorted row r.
+
+    a: [M, K] (w13: one row per token) or [M*top_k, K] (w2) bf16; b_q: [E, K/16, 2N] int32 Marlin words;
+    b_scales: [E, K/32, N] E8M0; sorted_token_ids/expert_ids/num_tokens_post_padded from
+    moe_align_block_size(topk_ids, BLOCK_M, E); c: [M*top_k, N] bf16.
+    """
+    K = b_q.shape[1] * 16
+    N = b_q.shape[2] // 2
+    BN, BK, num_warps, num_stages = _LONG_K_CFG if K >= 1024 else _SHORT_K_CFG
+    BN = min(BN, N)
+    assert a.shape[1] == K and N % BN == 0 and K % BK == 0 and a.stride(1) == 1 and c.stride(1) == 1
+    num_valid = topk_weights.numel()
+    a_div = top_k if a.shape[0] * top_k == num_valid else 1
+    grid = (triton.cdiv(sorted_token_ids.numel(), BLOCK_M) * (N // BN),)
+    _mxfp4_marlin_moe_kernel[grid](
+        a, b_q, b_scales.view(torch.uint8), c, topk_weights, sorted_token_ids, expert_ids, num_tokens_post_padded,
+        N, K, num_valid, a.stride(0), c.stride(0),
+        A_ROW_DIV=a_div, MUL_TOPK_W=mul_topk_weights, BM=BLOCK_M, BN=BN, BK=BK,
+        num_warps=num_warps, num_stages=num_stages)
+    return c
