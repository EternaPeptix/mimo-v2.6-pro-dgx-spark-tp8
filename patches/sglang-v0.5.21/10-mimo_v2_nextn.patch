+    def _build_fp8_head(self):
+        """FP8 copy of the draft lm_head (SGLANG_MTP_FP8_HEAD=1). The draft only proposes tokens and the
+        target verifies every one, so a lower-precision head cannot change outputs, only acceptance; it
+        halves the 234 MB/rank head read of each of the three draft steps. 128x128 blocks, amax scaling."""
+        if os.environ.get("SGLANG_MTP_FP8_HEAD", "0") != "1":
+            return
+        w = getattr(self.lm_head, "weight", None)
+        if w is None or w.dim() != 2 or w.dtype not in (torch.bfloat16, torch.float16) or w.shape[1] % 128:
+            return
+        prev = getattr(self.lm_head, "_fp8_draft_src", None)
+        if prev == w.data_ptr():
+            return
+        with torch.no_grad():
+            n, k = w.shape
+            nb = (n + 127) // 128
+            wp = torch.nn.functional.pad(w.float(), (0, 0, 0, nb * 128 - n))
+            blocks = wp.view(nb, 128, k // 128, 128)
+            scale = (blocks.abs().amax(dim=(1, 3)).clamp(min=1e-8) / 448.0).contiguous()
+            q = (blocks / scale[:, None, :, None]).clamp(-448.0, 448.0).to(torch.float8_e4m3fn)
+            q = q.view(nb * 128, k)[:n].contiguous()
+            del wp, blocks
+        self.lm_head._fp8_draft = (q, scale)
+        self.lm_head._fp8_draft_src = w.data_ptr()
+        logger.info("MTP draft lm_head: FP8 copy built %s (scale %s)", tuple(q.shape), tuple(scale.shape))
 
