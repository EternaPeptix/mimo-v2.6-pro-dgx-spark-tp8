+            self._prefill_pool = torch.cuda.MemPool()
+            with torch.cuda.use_mem_pool(self._prefill_pool):
+                self._prefill_pool_hold = torch.empty(
+                    int(_reserve_gb * (1 << 30)), dtype=torch.uint8, device=self.device
+                )
+            logger.info(f"Reserved {_reserve_gb:.1f} GB prefill activation pool")
