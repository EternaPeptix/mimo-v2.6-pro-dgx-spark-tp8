+        # Reserve a private pool now, while memory is contiguous, and run prefill inside it.
+        self._prefill_pool = None
+        self._prefill_pool_hold = None
+        _reserve_gb = float(os.environ.get("SGLANG_PREFILL_POOL_GB", "0") or 0)
