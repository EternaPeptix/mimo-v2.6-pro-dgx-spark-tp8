# cluster.env: copy to scripts/cluster.env and edit. Sourced by every script in scripts/ and bench/.
# All scripts run from a control machine that can `ssh <node>` to each Spark without a password.

# SSH names of the 8 Sparks, in TP-rank order. NODES[0] is rank 0: it serves the API on 127.0.0.1:30000.
NODES=(spark-1 spark-2 spark-3 spark-4 spark-5 spark-6 spark-7 spark-8)

# Rank 0's IP on the RoCE fabric (used for torch.distributed / NCCL / gloo bootstrap) and a free port.
MASTER_ADDR=10.77.0.11
MASTER_PORT=20000

# Fabric interface carrying MASTER_ADDR on every node, and the RoCE devices.
SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
IB_GID_INDEX=5            # RoCEv2 + IPv4 GID (check: show_gids, or /sys/class/infiniband/*/ports/1/gid_attrs/types/5)
# RDMA all-reduce: one RoCE device per PCIe x4 link of the ConnectX-7 (the GB10 reaches each port over
# two x4 links); pairs of ranks pick one of these two consistently.
RDMA_AR_HCAS=rocep1s0f0,roceP2p1s0f1

# Model location on each node (first existing entry wins; must contain config.json).
MODEL_DIRS="~/models/MiMo-V2.6-Pro-MOPD"   # literal ~ : expanded on each node; separate alternatives with :

IMAGE=${IMAGE:-mimo-gb10:v0.5.21}
